# Copy to .env and edit. .env is git-ignored; never commit real secrets.

# --- Core -----------------------------------------------------------------
DEBUG=True
# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed behind HTTPS, e.g. https://portal.dept.example.edu
CSRF_TRUSTED_ORIGINS=
SITE_NAME=Department Portal
TIME_ZONE=UTC

# --- Database -------------------------------------------------------------
# Defaults to SQLite. For Postgres (docker compose provides one):
# DATABASE_URL=postgres://django:django@localhost:5432/django
DATABASE_URL=

# --- Accounts -------------------------------------------------------------
# False = only an administrator can create accounts, via /admin/.
SIGNUP_OPEN=True
# Restrict self-registration, e.g. dept.example.edu,example.edu
SIGNUP_ALLOWED_EMAIL_DOMAINS=
LOGIN_RATELIMIT_ATTEMPTS=8
LOGIN_RATELIMIT_WINDOW=300

# --- Email ----------------------------------------------------------------
# Development prints password-reset emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Production only ------------------------------------------------------
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO
# CACHE_URL=redis://localhost:6379/1
